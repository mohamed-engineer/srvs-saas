# Supabase project settings (public key may be anon or publishable key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Preferred server-only Supabase secret key (sb_secret_...). Legacy service_role is accepted too.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL, without a trailing slash. Use an HTTPS tunnel for Kashier webhooks in local development.
APP_URL=http://localhost:3000
KASHIER_WEBHOOK_URL=

# Kashier credentials from one environment only (test or live)
KASHIER_MODE=test
KASHIER_MERCHANT_ID=
KASHIER_API_KEY=
KASHIER_SECRET_KEY=
KASHIER_ALLOWED_METHODS=card,wallet

# Set the agreed amounts in EGP before enabling checkout. Example format: 350.00
SRVS_PRICE_MONTHLY_EGP=
SRVS_PRICE_ANNUAL_EGP=
SRVS_PRICE_LIFETIME_EGP=
